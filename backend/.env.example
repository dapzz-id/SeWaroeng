# =============================================================================
# Neura Cakrawira Solusi | SeWaroeng
# Backend Environment Configuration
# =============================================================================

APP_NAME=SeWaroeng
APP_ENV=local
APP_KEY=base64:CHANGE_THIS_TO_RANDOM_32_BYTE_KEY==
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sewaroeng_db
DB_USERNAME=sewaroeng_user
DB_PASSWORD=sewaroeng_secret
DB_SSLMODE=disable
DB_POOL_MAX_OPEN=25
DB_POOL_MAX_IDLE=10
DB_POOL_MAX_LIFETIME=300

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=sewaroeng_redis_secret
REDIS_DATABASE=0

# ─── JWT / Authentication ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_BYTE_HEX_SECRET
JWT_TTL=15
JWT_ALGORITHM=HS256
REFRESH_TOKEN_TTL=10080
SESSION_TOKEN_TTL=10080

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=60

# ─── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_BYTE_KEY_FOR_AES256

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_DRIVER=redis
QUEUE_REDIS_CONNECTION=default
QUEUE_FAILED_TABLE=failed_jobs

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/app
# For S3-compatible (MinIO/Cloudflare R2/AWS):
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=sewaroeng-storage
# AWS_ENDPOINT=

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@sewaroeng.id
MAIL_FROM_NAME=SeWaroeng

# ─── Payment Gateways ─────────────────────────────────────────────────────────
# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-CHANGE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-CHANGE_ME
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1

# PayPal
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_MODE=sandbox
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Wise
WISE_API_TOKEN=CHANGE_ME
WISE_PUBLIC_KEY_PATH=./config/wise_public_key.pem
WISE_WEBHOOK_SECRET=CHANGE_ME
WISE_MODE=sandbox
WISE_API_URL=https://api.sandbox.transferwise.tech

# ─── PPOB Provider ────────────────────────────────────────────────────────────
PPOB_PROVIDER=stub
# PPOB_PROVIDER=digiflazz
# PPOB_DIGIFLAZZ_USERNAME=CHANGE_ME
# PPOB_DIGIFLAZZ_API_KEY=CHANGE_ME
# PPOB_DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Tenant-ID
CORS_MAX_AGE=3600

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug
