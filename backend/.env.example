APP_NAME=SeWaroeng
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TRUSTED_PROXIES=

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g. https://sewaroeng.neuracakrawira.asia).
# In production, defaults to planned frontend "https://sewaroeng.neuracakrawira.asia" if unset.
# In staging, this MUST be explicitly configured with the approved staging frontend origin.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL 16+ Mandatory)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sewaroeng

# Runtime Application Role (Least-privilege DML: SELECT, INSERT, UPDATE, DELETE only)
# Used for HTTP requests, queue workers, and scheduler. MUST retain NOSUPERUSER NOBYPASSRLS.
DB_USERNAME=sewaroeng_prod_app
DB_PASSWORD=

# Schema Migrator Role (DDL identity: executes 'php artisan migrate' and pg_dump)
# Used exclusively during deployment pipeline; NEVER persisted in runtime cached config
DB_MIGRATOR_USERNAME=sewaroeng_prod_migrator
DB_MIGRATOR_PASSWORD=

# Session, Queue, and Cache Drivers
# cPanel Production Profile (without local Redis): use 'database'
# Optional external cluster profile: use 'redis'
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=sewaroeng_cache_

# Redis Configuration (Optional: only required if CACHE_STORE=redis or QUEUE_CONNECTION=redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sewaroeng.neuracakrawira.asia"
MAIL_FROM_NAME="${APP_NAME}"
# --- Third-Party Integrations ---
# Midtrans Payment Gateway (Platform-level fallback / default gateway configuration)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BASE_URL=

# Duitku Payment Gateway (Platform-level fallback / default gateway configuration)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_IS_PRODUCTION=false

# Meta Cloud WhatsApp Business API (Platform-level webhook verification & default adapter settings)
# Note: Merchant-specific WhatsApp credentials (access tokens & phone number IDs) are stored
# encrypted in the tenant_whatsapp_connections database table via the management API.
META_WHATSAPP_GRAPH_VERSION=v21.0
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
SEWAROENG_SUPPORT_CONTACT=
