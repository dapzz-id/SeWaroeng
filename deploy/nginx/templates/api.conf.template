# ==============================================================================
# SeWaroeng — API Nginx Virtual Host Template
# Target: Ubuntu 22.04+ LTS / Debian 12+, PHP 8.4-FPM
# Variables: ${API_HOST}, ${APP_ROOT}, ${PHP_SOCKET}
# ==============================================================================

# HTTP — Phase 1 Bootstrap & ACME Challenge
# Serves port 80 for Let's Encrypt HTTP-01 challenge and liveness probe prior to TLS issuance.
server {
    listen 80;
    listen [::]:80;
    server_name ${API_HOST};

    # Root for ACME / Let's Encrypt webroot verification & Laravel entrypoint
    root ${APP_ROOT}/backend/public;
    index index.php;

    # Security: Deny direct access to hidden files (.env, .git, etc.)
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Let's Encrypt HTTP-01 Challenge Pass-through
    location ^~ /.well-known/acme-challenge/ {
        allow all;
        root ${APP_ROOT}/backend/public;
    }

    # API Routing & Proxy to PHP-FPM
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Health & Liveness probes (Unauthenticated, fast response)
    location = /up {
        try_files $uri /index.php?$query_string;
        access_log off;
    }

    location = /api/v1/health {
        try_files $uri /index.php?$query_string;
    }

    # PHP-FPM execution
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass ${PHP_SOCKET};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;

        # Webhook payload & signature preservation
        fastcgi_pass_request_headers on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 60s;
        fastcgi_connect_timeout 10s;
    }

    # Request size limits (supports receipts, avatar uploads, and batch imports)
    client_max_body_size 16M;

    # Logging
    access_log /var/log/nginx/${API_HOST}_access.log;
    error_log /var/log/nginx/${API_HOST}_error.log warn;
}

