###############################################################################
# Auto detect text files and normalize line endings
###############################################################################
* text=auto eol=lf

###############################################################################
# Source Code
###############################################################################
*.c          text
*.cpp        text
*.cc         text
*.h          text
*.hpp        text

*.java       text
*.kt         text
*.kts        text

*.cs         text
*.vb         text

*.php        text
*.go         text

*.js         text
*.jsx        text
*.ts         text
*.tsx        text

*.dart       text

*.py         text
*.rb         text
*.rs         text
*.swift      text
*.m          text
*.mm         text

###############################################################################
# Web
###############################################################################
*.html       text
*.htm        text
*.css        text
*.scss       text
*.sass       text
*.less       text

*.json       text
*.jsonc      text
*.yaml       text
*.yml        text
*.xml        text
*.toml       text
