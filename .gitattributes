###############################################################################
# Keep generated files as binary
###############################################################################
*.jar binary
*.apk binary
*.aab binary
*.ipa binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

###############################################################################
# GitHub Linguist
###############################################################################

# Dependencies
vendor/** linguist-vendored
node_modules/** linguist-vendored
Pods/** linguist-vendored

# Generated
build/** linguist-generated
dist/** linguist-generated
coverage/** linguist-generated
*.g.dart linguist-generated
*.freezed.dart linguist-generated
*.gr.dart linguist-generated

# Flutter
.flutter-plugins linguist-generated
.flutter-plugins-dependencies linguist-generated

*.dart linguist-language=Dart
*.go linguist-language=Go
*.php linguist-language=PHP
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.html linguist-language=HTML
*.css linguist-language=CSS
*.scss linguist-language=SCSS
*.sql linguist-language=SQL